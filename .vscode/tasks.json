{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make dev",
            "type": "shell",
            "command": "make dev",
            "isBackground": false,
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "typescript",
                "source": "ts",
                "applyTo": "closedDocuments",
                "fileLocation": ["relative", "${cwd}"],
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*",
                    "endsPattern": "^.*Terminal will be reused by tasks, press any key to close it.*"
                }
            }
        }
    ]
}
