{
    "name": "metadata-engine",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/metadata-engine/src",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": [
                "production",
                {
                    "runtime": "rustc -vV"
                }
            ],
            "outputs": ["{projectRoot}/target/dev/release"],
            "options": {
                "command": "cargo build --release --target-dir target/dev",
                "cwd": "apps/metadata-engine"
            }
        },
        "build-package": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/target/release"],
            "options": {
                "command": "node scripts/build.mjs",
                "cwd": "apps/metadata-engine"
            }
        },
        "build-debug": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/target/debug"],
            "options": {
                "command": "cargo build",
                "cwd": "apps/metadata-engine"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "inputs": ["default", "{workspaceRoot}/fixtures/metadata/**/*"],
            "options": {
                "command": "cargo test",
                "cwd": "apps/metadata-engine"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo clippy --all-targets",
                "cwd": "apps/metadata-engine"
            }
        }
    }
}
