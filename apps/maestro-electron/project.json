{
    "name": "maestro-electron",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/maestro-electron/src",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:noop",
            "dependsOn": ["^build", "build-app", "metadata-engine:build"]
        },
        "build-app": {
            "executor": "nx-electron:build",
            "cache": true,
            "inputs": ["production", "^production"],
            "outputs": ["{options.outputPath}"],
            "dependsOn": ["^build"],
            "options": {
                "outputPath": "dist/apps/maestro-electron",
                "main": "apps/maestro-electron/src/main.ts",
                "tsConfig": "apps/maestro-electron/tsconfig.app.json",
                "webpackConfig": "apps/maestro-electron/webpack.config.cjs",
                "assets": ["apps/maestro-electron/src/assets"]
            },
            "configurations": {
                "development": {},
                "production": {
                    "optimization": true,
                    "extractLicenses": true,
                    "inspect": false,
                    "fileReplacements": [
                        {
                            "replace": "apps/maestro-electron/src/environments/environment.ts",
                            "with": "apps/maestro-electron/src/environments/environment.prod.ts"
                        }
                    ]
                }
            },
            "defaultConfiguration": "production"
        },
        "serve-internal": {
            "executor": "nx-electron:execute",
            "options": {
                "buildTarget": "maestro-electron:build-app",
                "remoteDebuggingPort": 9222,
                "inspect": "inspect",
                "port": 5858
            }
        },
        "serve": {
            "dependsOn": ["metadata-engine:build"],
            "continuous": true,
            "command": "node tools/dev-instance/cli.mjs run-dev"
        },
        "package": {
            "dependsOn": [
                "maestro-renderer:build",
                "prepare-icons",
                "build-app",
                "metadata-engine:build-package"
            ],
            "executor": "nx-electron:package",
            "cache": true,
            "outputs": ["{workspaceRoot}/dist/packages"],
            "options": {
                "name": "maestro-electron",
                "sourcePath": "dist/apps",
                "outputPath": "dist/packages",
                "files": [
                    {
                        "from": "maestro-renderer/browser",
                        "to": "maestro-renderer",
                        "filter": ["**/*"]
                    }
                ],
                "prepackageOnly": true
            }
        },
        "make": {
            "dependsOn": [
                "maestro-renderer:build",
                "prepare-icons",
                "build-app",
                "metadata-engine:build-package"
            ],
            "executor": "nx-electron:make",
            "cache": true,
            "outputs": ["{workspaceRoot}/dist/executables"],
            "options": {
                "name": "maestro-electron",
                "sourcePath": "dist/apps",
                "outputPath": "dist/executables",
                "files": [
                    {
                        "from": "maestro-renderer/browser",
                        "to": "maestro-renderer",
                        "filter": ["**/*"]
                    }
                ]
            },
            "defaultConfiguration": "production"
        },
        "prepare-icons": {
            "dependsOn": ["maestro-renderer:build"],
            "command": "node -e \"const fs = require('node:fs'); fs.rmSync('dist/assets/icons', { recursive: true, force: true }); fs.mkdirSync('dist/assets', { recursive: true }); fs.cpSync('dist/apps/maestro-renderer/browser/icons', 'dist/assets/icons', { recursive: true });\""
        },
        "lint": {
            "command": "eslint apps/maestro-electron/**/*.ts"
        },
        "test": {
            "command": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/jest/bin/jest.js --config apps/maestro-electron/jest.config.ts"
        }
    }
}
