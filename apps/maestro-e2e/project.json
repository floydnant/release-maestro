{
    "name": "maestro-e2e",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/maestro-e2e/src",
    "implicitDependencies": ["maestro-renderer", "maestro-electron", "metadata-engine"],
    "// targets": "to see all targets run: nx show project maestro-e2e --web",
    "targets": {
        "e2e": {
            "dependsOn": ["typecheck", "maestro-electron:build"],
            "command": "playwright test -c apps/maestro-e2e/playwright.electron.config.ts"
        },
        "e2e-production": {
            "dependsOn": ["typecheck", "maestro-electron:package"],
            "command": "playwright test -c apps/maestro-e2e/playwright.electron.production.config.ts"
        },
        "e2e-renderer": {
            "dependsOn": ["typecheck"],
            "command": "playwright test -c apps/maestro-e2e/playwright.renderer.config.ts"
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "typecheck": {
            "cache": true,
            "inputs": ["default", "^default"],
            "command": "tsc --noEmit -p apps/maestro-e2e/tsconfig.json"
        }
    }
}
