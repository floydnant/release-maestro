{
    "name": "eslint-plugin-design-system",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/eslint-plugin-design-system/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "lint": {
            "executor": "@nx/eslint:lint",
            "dependsOn": ["typecheck"]
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "libs/eslint-plugin-design-system/jest.config.cjs"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx tsc --noEmit -p libs/eslint-plugin-design-system/tsconfig.lib.json"
            }
        }
    }
}
